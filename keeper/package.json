{
    "name": "@nori-zk/backstop-keeper",
    "version": "0.0.1",
    "description": "Backstop keeper and its library: from a NoriSnapshot transaction to a Backstop submitRead",
    "license": "MIT",
    "type": "module",
    "main": "build/index.js",
    "types": "build/index.d.ts",
    "exports": {
        ".": {
            "import": "./build/index.js"
        }
    },
    "scripts": {
        "clean": "rimraf build",
        "build": "npm run clean && tsc",
        "test": "npm run build && node --experimental-wasm-modules --test 'build/**/*.test.js'",
        "test-ci": "npm run test",
        "lint": "npx eslint src",
        "keeper": "node --experimental-wasm-modules build/bin/keeper.js",
        "migrate": "node --experimental-wasm-modules build/bin/migrate.js",
        "fake-prover": "node --experimental-wasm-modules build/bin/fakeProver.js"
    },
    "dependencies": {
        "@nori-zk/ethereum-snapshot": "*",
        "@nori-zk/ethereum-tempo-bridge": "0.0.1",
        "@nori-zk/ethereum-tempo-proof-queue-utils-glam": "0.0.1",
        "@nori-zk/nori-bridge-tempo-sdk": "0.1.1",
        "@nori-zk/tempo-backstop": "*",
        "@nori-zk/tempo-token-bridge": "0.0.2",
        "@yaw-rx/ystate": "^0.1.0",
        "dotenv": "^17.2.4",
        "ethers": "^6.16.0",
        "rxjs": "^7.8.2"
    },
    "devDependencies": {
        "@types/node": "^25.2.3"
    }
}
