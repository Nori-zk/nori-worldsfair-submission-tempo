
# Built into every app and dashboard under web/ (web/env.ts). Public values
# only: everything here reaches the browser. The shell environment wins.

# Ethereum (Sepolia) ============================================================
ETH_CHAIN_ID=11155111
# A public Ethereum RPC for reads, so they work without a wallet. It must keep
# logs back to the queue's deploy block (publicnode prunes them).
ETH_RPC_URL=https://sepolia.gateway.tenderly.co
NORI_ETH_PROOF_QUEUE_ADDRESS=0x9AeAc0174f7bDf397C6dB1f62c120E8170e5B87e
# The first block to read proof requests from: the queue's deploy block
NORI_WEB_PROOF_QUEUE_DEPLOY_BLOCK=11856173
NORI_ETH_SNAPSHOT_ADDRESS=0xC377EbBF516a9DB2Fe5AEB65fA19D4dca1717340
# nori-tempo-sdk's NoriTokenBridge on that queue: the migrate app locks in it
NORI_ETH_TOKEN_BRIDGE_ADDRESS=

# Tempo (Moderato) ==============================================================
TEMPO_CHAIN_ID=42431
TEMPO_RPC_NETWORK_URL=https://rpc.moderato.tempo.xyz
TEMPO_WSS_NETWORK_URL=wss://rpc.moderato.tempo.xyz
# The NoriTempoTokenBridge on Moderato that proves NORI_ETH_PROOF_QUEUE_ADDRESS
NORI_TEMPO_TOKEN_BRIDGE_ADDRESS=

# Migration =====================================================================
# The ERC-20 the migrate app moves to its TIP-20 on Tempo (DUSD: the root
# README's migration deploy). The migrate app's build needs it and
# NORI_ETH_TOKEN_BRIDGE_ADDRESS; the other apps do not.
NORI_WEB_MIGRATION_TOKEN=

# Bridge ========================================================================
NORI_WEB_BRIDGE_WSS_URL=wss://wss.tempo.nori.it.com

# Apps ==========================================================================
# Each app's and dashboard's address, for the links along the top of every page:
# the dev servers by default. Once hosted, set the hosted ones in the host's
# build environment.
NORI_WEB_PROVE_BALANCE_URL=http://localhost:5180
NORI_WEB_MIGRATE_URL=http://localhost:5181
NORI_WEB_DASHBOARD_URL=http://localhost:7400
# Optional: the Solana submission's bridge dashboard. Empty leaves its link out.
NORI_WEB_SOLANA_DASHBOARD_URL=
