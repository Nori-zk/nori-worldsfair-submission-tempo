{
    "name": "@nori-zk/tempo-migrate-app",
    "version": "0.0.1",
    "private": true,
    "description": "Migrate an Ethereum ERC-20 to its TIP-20 on Tempo through Nori: lock on Ethereum, claim on Tempo, its pause followed by proof",
    "license": "MIT",
    "type": "module",
    "scripts": {
        "prepare": "ts-patch install",
        "dev": "vite",
        "clean": "rimraf dist",
        "build": "npm run clean && vite build",
        "build:ssg": "yaw-ssg dist public",
        "preview": "vite preview",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src/",
        "lint:fix": "eslint src/ --fix",
        "format": "prettier --check src/",
        "format:fix": "prettier --write src/"
    },
    "dependencies": {
        "@nori-zk/ethereum-tempo-bridge": "file:../../../../nori-tempo-sdk/ethereum",
        "@nori-zk/nori-bridge-tempo-sdk": "file:../../../../nori-tempo-sdk/sdk",
        "@nori-zk/tempo-token-bridge": "file:../../../../nori-tempo-sdk/tempo",
        "@nori-zk/tempo-web-ui": "*",
        "@yaw-rx/core": "^0.1.3",
        "@yaw-rx/ystate": "^0.1.0",
        "ethers": "^6.16.0",
        "rxjs": "8.0.0-alpha.14"
    },
    "devDependencies": {
        "@yaw-rx/ssg": "^0.1.2",
        "@yaw-rx/transformer": "^0.1.2",
        "@yaw-rx/ts-plugin": "^0.1.2",
        "@yaw-rx/vite": "^0.1.3",
        "dotenv": "^17.2.4",
        "ts-patch": "^3.3.0",
        "vite": "^5.0.0"
    }
}
