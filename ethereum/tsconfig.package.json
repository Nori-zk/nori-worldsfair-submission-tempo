{
    "compilerOptions": {
        "target": "es2020",
        "module": "nodenext",
        "lib": ["es2020", "dom"],
        "moduleResolution": "nodenext",
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "resolveJsonModule": true,
        "strict": true,
        "declaration": true,
        "outDir": "build",
        "skipLibCheck": true
    },
    "include": [
        "index.ts",
        "kelpReplay.const.ts",
        "queries.ts",
        "snapshotProof.ts",
        "contracts/**/*.const.ts",
        "./artifacts"
    ],
    "exclude": ["node_modules", "**/*.test.ts", "**/*.spec.ts"]
}
