{
    "ethereum": {
        "rpcUrl": "${ETH_RPC_URL}",
        "chainId": "${ETH_CHAIN_ID}",
        "noriSnapshot": "${NORI_ETH_SNAPSHOT_ADDRESS}",
        "proofQueue": "${NORI_ETH_PROOF_QUEUE_ADDRESS}"
    },
    "tempo": {
        "rpcUrl": "${TEMPO_RPC_NETWORK_URL}",
        "chainId": "${TEMPO_CHAIN_ID}",
        "bridge": "${NORI_TEMPO_TOKEN_BRIDGE_ADDRESS}",
        "backstop": "${NORI_TEMPO_BACKSTOP_ADDRESS}"
    },
    "intervals": {
        "snapshotSecs": 900,
        "checkpointSecs": 120,
        "pollSecs": 30
    },
    "stateFile": "keeper-soak-state.json",
    "guards": [
        {
            "name": "demo-lockbox",
            "token": "${BACKSTOP_DEMO_TOKEN}",
            "backing": {
                "target": "${NORI_ETH_DEMO_LOCKBOX_ADDRESS}",
                "signature": "locked()",
                "args": []
            },
            "pause": {
                "target": "${NORI_ETH_DEMO_LOCKBOX_ADDRESS}",
                "signature": "paused()",
                "args": []
            },
            "backingDecimals": 18,
            "tolerance": "1000000",
            "windowSecs": 600,
            "skewSecs": 60,
            "checkpointIntervalSecs": 120,
            "maxStalenessSecs": 7200
        },
        {
            "name": "shadow-lockbox",
            "token": "${BACKSTOP_SHADOW_TOKEN}",
            "backing": {
                "target": "${NORI_ETH_SHADOW_LOCKBOX_ADDRESS}",
                "signature": "locked()",
                "args": []
            },
            "pause": {
                "target": "${NORI_ETH_SHADOW_LOCKBOX_ADDRESS}",
                "signature": "paused()",
                "args": []
            },
            "backingDecimals": 18,
            "tolerance": "1000000",
            "windowSecs": 600,
            "skewSecs": 60,
            "checkpointIntervalSecs": 120,
            "maxStalenessSecs": 7200
        }
    ]
}
