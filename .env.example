# One .env for the whole repo: cp .env.example .env (gitignored).
# Read by the ethereum and tempo scripts, the keeper and the migration CLI. The
# shell environment wins over it. Deploys write their addresses to
# ethereum/.env.nori-eth-snapshot, ethereum/.env.nori-eth-demo,
# ethereum/.env.nori-eth-migration, tempo/.env.nori-tempo-backstop and
# tempo/.env.nori-tempo-demo; the keeper and the migration CLI read those too.

# Ethereum ===================================================================
# sepolia, mainnet, hoodi, ... (the Hardhat network name)
ETH_NETWORK=sepolia
ETH_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# The chain ETH_RPC_URL serves; the keeper's connections check it (Sepolia)
ETH_CHAIN_ID=11155111
# Deployer, and the keeper's snapshot signer (hex)
ETH_PRIVATE_KEY=

# The proof queue bridge-head proves; NoriSnapshot and NoriTokenBridge enqueue on it.
# Unset: `npm run deploy -w ethereum` deploys a dedicated queue too.
NORI_ETH_PROOF_QUEUE_ADDRESS=0x9AeAc0174f7bDf397C6dB1f62c120E8170e5B87e
# Only for a newly deployed queue: operator (defaults to the deployer),
# fee recipient, and per-request fee in wei (a multiple of 10^12)
NORI_ETH_SNAPSHOT_QUEUE_OPERATOR_ADDRESS=
NORI_ETH_SNAPSHOT_QUEUE_FEE_RECIPIENT_ADDRESS=
NORI_ETH_SNAPSHOT_PROOF_REQUEST_QUEUE_FEE_WEI=0
# nori-tempo-sdk's NoriTokenBridge on that queue: holders lock ERC-20s in it,
# and syncPause carries an ERC-20's pause to its mirror (migration)
NORI_ETH_TOKEN_BRIDGE_ADDRESS=

# npm run test:fork -w ethereum (default: https://ethereum-rpc.publicnode.com)
ETH_MAINNET_FORK_RPC_URL=
# Optional: fork at this block, for reproducible gas (needs an archive RPC)
ETH_MAINNET_FORK_BLOCK=

# Tempo (same names as nori-tempo-sdk) =========================================
# localnet for a local `anvil --network tempo` (its unlocked dev accounts sign),
# or any name for a live network
TEMPO_NETWORK=moderato
TEMPO_RPC_NETWORK_URL=https://rpc.moderato.tempo.xyz
# The chain TEMPO_RPC_NETWORK_URL serves; the keeper's connections check it (Moderato)
TEMPO_CHAIN_ID=42431
# Deployer, guard admin and the keeper's Tempo signer (hex); pays fees in the
# account's fee token (pathUSD on Moderato, from the faucet)
TEMPO_PRIVATE_KEY=
# The NoriTempoTokenBridge bridge-head updates, proving NORI_ETH_PROOF_QUEUE_ADDRESS
NORI_TEMPO_TOKEN_BRIDGE_ADDRESS=
# Backstop. scripts/deploy-moderato.sh deploys it and writes it to
# tempo/.env.nori-tempo-backstop; set it here only to use another one.
NORI_TEMPO_BACKSTOP_ADDRESS=

# Backstop demo ================================================================
# The TIP-20 the demo guard watches. scripts/deploy-moderato.sh creates it and
# writes it to tempo/.env.nori-tempo-demo; set it here only to use another token.
BACKSTOP_DEMO_TOKEN=

# Migration demo ===============================================================
# DUSD, the issuer's ERC-20 migrated to Tempo. `npm run deploy-issuer-token -w ethereum`
# deploys it and writes it to ethereum/.env.nori-eth-migration; set it here only to
# migrate another token.
NORI_ETH_ISSUER_TOKEN_ADDRESS=
